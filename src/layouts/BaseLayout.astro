---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import Schema from '../components/Schema.astro';
import { SITE, ANALYTICS } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  ogImage?: string;
}

const {
  title = SITE.name + ' — ' + SITE.tagline,
  description = SITE.description,
  canonical = `${SITE.url}${Astro.url.pathname}`,
  noindex = false,
  ogImage = SITE.socialImage
} = Astro.props;

const fullTitle = title.includes(SITE.shortName) || title.includes(SITE.name)
  ? title
  : `${title} | ${SITE.name}`;
---
<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="google-site-verification" content="cJUcGChOzIXAIOMKpirNVf_Arf40EplqPjXB-m_AlYg" />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/favicon.svg" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <meta property="og:type" content="website" />
  <meta property="og:locale" content="he_IL" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:image" content={`${SITE.url}${ogImage}`} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${SITE.url}${ogImage}`} />

  <meta name="theme-color" content="#1f3a1f" />
  <meta name="format-detection" content="telephone=yes" />

  <Schema />
  <slot name="head-extra" />

  {ANALYTICS.googleTagId && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ANALYTICS.googleTagId}`}></script>
      <script is:inline define:vars={{ tagId: ANALYTICS.googleTagId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){ dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', tagId);
      </script>
    </>
  )}
</head>
<body>
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:right-2 focus:bg-forest-700 focus:text-white focus:px-4 focus:py-2 focus:rounded">דלג לתוכן הראשי</a>
  <Header />
  <main id="main">
    <slot />
  </main>
  <Footer />
  <WhatsAppFloat />

  {ANALYTICS.googleTagId && (
    <script is:inline define:vars={{ tagId: ANALYTICS.googleTagId, convLabel: ANALYTICS.googleAdsConversionLabel }}>
      document.addEventListener('click', function (e) {
        var link = e.target.closest ? e.target.closest('a[href]') : null;
        if (!link) return;
        var href = link.getAttribute('href') || '';
        var method = null;
        if (href.indexOf('wa.me') !== -1) method = 'whatsapp';
        else if (href.indexOf('tel:') === 0) method = 'phone';
        if (!method || typeof gtag !== 'function') return;
        gtag('event', 'generate_lead', { method: method });
        if (convLabel) {
          gtag('event', 'conversion', { send_to: tagId + '/' + convLabel });
        }
      }, true);
    </script>
  )}
</body>
</html>
